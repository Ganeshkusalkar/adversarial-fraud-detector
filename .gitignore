# Virtual environment
venv/
.venv/
env/
ENV/

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Dataset files (avoid pushing gigabytes of Kaggle data to GitHub)
data/*
!data/.gitkeep
*.csv
*.xlsx
*.parquet
*.npy

# Local environment configs and secrets
.env
config/*_config.yaml
!config/base_config.yaml

# IDE settings
.vscode/
.idea/

# Large model checkpoints (keep production ONNX and scalers)
artifacts/checkpoints/*.pt
*.pt
*.pth
!artifacts/
!artifacts/production/
!artifacts/production/**

# Local temporary or unnecessary files
*.zip
runs.json
scratch/
adversarial-fraud-detector/
